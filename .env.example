# The relay's VAPID PUBLIC key (the public half — safe to embed in the client).
# Web Push REQUIRES this to subscribe; the relay has no endpoint to fetch it at
# runtime, so it is baked in at build time. Generate it on the backend with
# `go run ./cmd/gen-vapid` and paste the PUBLIC key here.
#
# This is the only env var this repo needs. The private key stays on the relay.
VITE_VAPID_PUBLIC_KEY=
